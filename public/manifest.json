{
  "name": "Spill — Real Stories, Stronger Communities",
  "short_name": "Spill",
  "description": "Decentralized anonymous reporting, peer-to-peer support, and community audio spaces.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0D0C0B",
  "theme_color": "#ff5727",
  "orientation": "portrait-primary",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "bundle",
          "accept": [
            "text/plain",
            "application/json",
            ".txt",
            ".json"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/assets/spill-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/spill-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/spill-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/spill-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["social", "news", "finance"]
}
