# Public browser setting. This must point to the token service, never directly to LiveKit secrets.
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:3001/api/livekit/token

# Local token service settings. Copy this file to .env.local and add your LiveKit Cloud values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
APP_ORIGIN=http://localhost:5173
TOKEN_SERVER_PORT=3001

# Development only. Keep false in deployed environments until host authorization exists.
LIVEKIT_DEMO_ALLOW_HOST=false
