        "uncertain": true
      },
      {
        "start": 7.14,
        "end": 13.599999,
        "text": "Su ikili opita, vua ikin nesha magia aigia kuenen numbazetu.",
        "uncertain": true
      },
      {
        "start": 14.099999,
        "end": 19.8,
        "text": "Watotoa laudua magondua jatumbo, da hakuna aiekudak usafisa.",
        "uncertain": true
      },
      {
        "start": 19.8,
        "end": 24.8,
        "text": "Tume muambia txifu marabili, lakili hakuna kilitso fanika.",
        "uncertain": true
      },
      {
        "start": 24.8,
        "end": 33.32,
        "text": "Nika, tuna omba zerikaliaka untitume batuak usafixan taro buharaka ibe kanabio.",
        "uncertain": false
      },
      {
        "start": 33.32,
        "end": 42.92,
        "text": "Pia tuna omba mahirari bote batxan diekidodo, ilitun nuen bifabia usafixan bakatitu kizubiri zara.",
