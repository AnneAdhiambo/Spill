# Spill radio: copy this file to radio/.env and edit. radio/.env is git-ignored. NEVER commit real values.
#
#   SECRET      = a real credential. Keep it only in radio/.env, never in Git, chat or screenshots.
#   (no label)  = safe to share; the value shown is a working local default.
#
# Read by: the API (apps/api), the worker (apps/worker), docker-compose.dev.yml and start-demo.sh.
# Run API/worker through `dotenv -e .env -- ...` (start-demo.sh does this for you).

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=blocktek_radio
POSTGRES_USER=blocktek_radio
# SECRET. Choose your own. Use only letters, digits, "-" and "_" so it is safe inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-value
# SECRET (contains the password). The password here MUST equal POSTGRES_PASSWORD.
DATABASE_URL=postgresql://blocktek_radio:replace-with-a-long-random-value@localhost:5432/blocktek_radio
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Host ports for the Docker services
# Change these (and DATABASE_URL / REDIS_URL / ICECAST_PORT / the relay URL) only if the defaults are taken.
POSTGRES_PORT=5432
REDIS_PORT=6379
RELAY_PORT=7777
# Containers are named <prefix>-postgres, -redis, -icecast, -relay. start-demo.sh uses the same prefix.
SPILL_CONTAINER_PREFIX=spill
# 127.0.0.1 = reachable from this machine only (recommended; Redis has no password).
SPILL_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS. It must contain the exact origin (scheme + host + PORT)
# of the front end, e.g. http://localhost:5173. A wrong port gives "blocked by CORS" in the browser.
CORS_ORIGINS=http://localhost:5173
BLOCKTEK_AUTH_MODE=development
# SECRET. Only needed when BLOCKTEK_AUTH_MODE=trusted-proxy (at least 32 characters). Leave empty for local use.
BLOCKTEK_AUTH_SHARED_SECRET=
# SECRET. Reserved for authenticated workflows. Leave the placeholder for local use.
AUTH_SECRET=replace-with-a-long-random-value
# Only used by the optional Next.js app in radio/ (not the Vite front end).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------- AI DJ (worker)
# The worker only uses AI when AI_PROVIDER=groq. Anything else gives the deterministic fallback.
AI_PROVIDER=groq
AI_PROGRAMMING_MODE=AI_ASSISTED
AI_TIMEOUT_MS=12000
AI_MODEL=
AI_PROVIDER_URL=
# SECRET. Only for AI_PROVIDER=openai-compatible.
AI_PROVIDER_API_KEY=

# ---------------------------------------------------------------- Groq (DJ text + speech-to-text)
# SECRET. Get one at https://console.groq.com. Without it, no transcripts and no AI DJ lines.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Speech-to-text model. It must be exactly this name; other spellings give a 400 "model not found".
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional ISO-639-1 hint such as sw or en. Empty = auto-detect.
GROQ_WHISPER_LANGUAGE=
# groq-whisper (default) or microsoft (not available yet; it always fails).
TRANSCRIBER_PROVIDER=groq-whisper

# Optional providers (not used by the demo path).
# SECRET
ASI_CLOUD_API_KEY=
# SECRET
ASI_CLOUD_API_KEY2=
ASI_CLOUD_BASE_URL=https://llm.c.singularitynet.io/v1
ASI_CLOUD_CHAT_MODEL=asi1-mini
# SECRET
OPENAI_API_KEY=
# SECRET
GEMINI_API_KEY=

# ---------------------------------------------------------------- Radio worker
RADIO_BROADCAST_ENABLED=true
RADIO_STREAM_ENABLED=true
RADIO_STATION_ID=spill-main
RADIO_STATION_NAME=Spill
RADIO_STREAM_NAME=Signal / Main
# URL browsers use to play the stream. Its port must equal ICECAST_PORT.
RADIO_PUBLIC_STREAM_URL=http://localhost:8000/live
RADIO_STREAM_URL=
RADIO_AUDIO_BITRATE=128k
RADIO_METADATA_INTERVAL_SECONDS=180
RADIO_INGEST_POLL_MS=30000
RADIO_TRANSCRIPT_OFFSET_MS=3000
RADIO_REPEAT_COOLDOWN_ITEMS=3
RADIO_MAX_ITEM_SECONDS=1800
# true = play a test tone when there is no media. Leave false for the real demo.
RADIO_TEST_TONE_ENABLED=false

# ---------------------------------------------------------------- Icecast
# Where the WORKER connects (host side of the Docker port mapping).
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_MOUNT=/live
ICECAST_SOURCE_USER=source
# SECRET. The worker uses it to publish; Icecast checks it.
ICECAST_SOURCE_PASSWORD=replace-with-a-long-random-value
# SECRET. Icecast admin page.
ICECAST_ADMIN_PASSWORD=replace-with-a-long-random-value
# SECRET if you ever use Icecast relaying. "disabled" is a safe non-secret default.
ICECAST_RELAY_PASSWORD=disabled
ICECAST_HOSTNAME=localhost
# Production compose only (docker-compose.yml). Not used by docker-compose.dev.yml, which allows any origin.
ICECAST_CORS_ORIGIN=http://localhost:5173
BLOCKTEK_ICECAST_BIND_PORT=8000
BLOCKTEK_WEB_BIND_PORT=3010
BLOCKTEK_API_BIND_PORT=4010

# ---------------------------------------------------------------- Media
# Relative paths are resolved against radio/, not the folder you run from. An absolute path also works.
MEDIA_ROOT=./media
FALLBACK_AUDIO_PATH=./media/fallback
BLOCKTEK_MEDIA_PATH=./media

# ---------------------------------------------------------------- Midnight (optional, not used by the demo)
MIDNIGHT_NETWORK=unconfigured
# MIDNIGHT_NETWORK_ID=
# MIDNIGHT_NODE_URL=
# MIDNIGHT_INDEXER_URL=
# MIDNIGHT_PROOF_SERVER_URL=
# MIDNIGHT_ZK_CONFIG_URL=
# MIDNIGHT_VERIFIER_URL=
# MIDNIGHT_CONTRACT_ADDRESS=
# MIDNIGHT_WALLET_PUBLIC_ADDRESS=
# SECRET
# MIDNIGHT_STORAGE_PASSWORD=
# SECRET
# MIDNIGHT_FAUCET_CAPTCHA_TOKEN=

# ---------------------------------------------------------------- Front end (Vite) variables
# IMPORTANT: Vite reads these from the REPO ROOT (Spill/.env.local), NOT from radio/.env, and bakes them
# in at build time (`pnpm build`). start-demo.sh sets the first three for you from the ports above.
# They are listed here so every variable lives in one place. All are public (visible in the browser):
# never put a secret in a VITE_* variable.
#   VITE_RADIO_API_URL=http://localhost:4000
#   VITE_RADIO_STREAM_URL=http://localhost:8000/live
#   VITE_NOSTR_RELAYS=ws://localhost:7777
#   VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:3001/api/livekit/token
#   VITE_CASHU_TEST_MINT=
#   VITE_BITCOIN_PRICE_ENDPOINT=
# The LiveKit token server (pnpm dev:token, optional) reads LIVEKIT_URL, LIVEKIT_API_KEY (SECRET),
# LIVEKIT_API_SECRET (SECRET), APP_ORIGIN, TOKEN_SERVER_PORT and LIVEKIT_DEMO_ALLOW_HOST
# from Spill/.env.local. See Spill/.env.example.
