# Public browser setting. This must point to the token service, never directly to LiveKit secrets.
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:3001/api/livekit/token

# Local token service settings. Copy this file to .env.local and add your LiveKit Cloud values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
APP_ORIGIN=http://localhost:5173
TOKEN_SERVER_PORT=3001

# Development only. Keep false in deployed environments until host authorization exists.
LIVEKIT_DEMO_ALLOW_HOST=false


# Cashu / premium rooms. CASHU_MINT_URL is the single mint allowlist.
CASHU_MINT_URL=https://your-cashu-mint.example
DATABASE_URL=postgres://spill:change-me@localhost:5432/spill
PREMIUM_ROOM_IDS=premium-room-id
# 32-byte hex values. Never commit real values.
CASHU_PLATFORM_P2PK_PRIVATE_KEY=
CASHU_PLATFORM_PROOF_ENCRYPTION_KEY=
